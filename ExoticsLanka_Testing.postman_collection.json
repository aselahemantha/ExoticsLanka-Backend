{
	"info": {
		"_postman_id": "a2390a0e-a112-49b1-bd4f-12e5e004c9b5",
		"name": "ExoticsLanka Comprehensive API",
		"description": "Full Postman Collection for ExoticsLanka Microservices: Auth, Profile, Listings, and Images.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Auth Service",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"name\": \"John Doe\",\n  \"role\": \"seller\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url_auth}}/api/auth/register",
							"host": ["{{base_url_auth}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set(\"auth_token\", jsonData.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url_auth}}/api/auth/login",
							"host": ["{{base_url_auth}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Get Me (Auth)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"url": {
							"raw": "{{base_url_auth}}/api/auth/me",
							"host": ["{{base_url_auth}}"],
							"path": ["api", "auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "2. Profile Service",
			"item": [
				{
					"name": "Get My Profile",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"url": {
							"raw": "{{base_url_profile}}/api/users/me",
							"host": ["{{base_url_profile}}"],
							"path": ["api", "users", "me"]
						}
					}
				},
				{
					"name": "Update Profile",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Updated\",\n  \"bio\": \"Collector of rare cars\",\n  \"phone\": \"+94 77 123 4567\"\n}"
						},
						"url": {
							"raw": "{{base_url_profile}}/api/users/me",
							"host": ["{{base_url_profile}}"],
							"path": ["api", "users", "me"]
						}
					}
				},
				{
					"name": "Request Verification",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"dealer\"\n}"
						},
						"url": {
							"raw": "{{base_url_profile}}/api/users/me/verification",
							"host": ["{{base_url_profile}}"],
							"path": ["api", "users", "me", "verification"]
						}
					}
				}
			]
		},
		{
			"name": "3. Listing Service",
			"item": [
				{
					"name": "Create Listing",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set(\"listing_id\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"2021 Porsche 911 Carrera\",\n  \"make\": \"Porsche\",\n  \"model\": \"911 Carrera\",\n  \"year\": 2021,\n  \"price\": 42000000,\n  \"mileage\": 13500,\n  \"condition\": \"used\",\n  \"bodyType\": \"Coupe\",\n  \"fuelType\": \"Petrol\",\n  \"transmission\": \"Automatic\",\n  \"color\": \"White\",\n  \"doors\": 2,\n  \"seats\": 4,\n  \"engineSize\": \"3.0L\",\n  \"drivetrain\": \"RWD\",\n  \"features\": [\"Leather Seats\", \"Navigation System\"],\n  \"description\": \"Well-maintained 911\",\n  \"location\": \"Colombo\"\n}"
						},
						"url": {
							"raw": "{{base_url_listings}}/api/listings",
							"host": ["{{base_url_listings}}"],
							"path": ["api", "listings"]
						}
					}
				},
				{
					"name": "Get All Listings",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url_listings}}/api/listings?limit=10&page=1",
							"host": ["{{base_url_listings}}"],
							"path": ["api", "listings"],
							"query": [
								{"key": "limit", "value": "10"},
								{"key": "page", "value": "1"}
							]
						}
					}
				},
				{
					"name": "Get Listing By ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url_listings}}/api/listings/{{listing_id}}",
							"host": ["{{base_url_listings}}"],
							"path": ["api", "listings", "{{listing_id}}"]
						}
					}
				},
				{
					"name": "Add Favorite",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"url": {
							"raw": "{{base_url_listings}}/api/listings/{{listing_id}}/favorite",
							"host": ["{{base_url_listings}}"],
							"path": ["api", "listings", "{{listing_id}}", "favorite"]
						}
					}
				}
			]
		},
		{
			"name": "4. Image Service",
			"item": [
				{
					"name": "Upload Listing Image",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set(\"image_id\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{"key": "image", "type": "file", "src": []}
							]
						},
						"url": {
							"raw": "{{base_url_images}}/api/listings/{{listing_id}}/images",
							"host": ["{{base_url_images}}"],
							"path": ["api", "listings", "{{listing_id}}", "images"]
						}
					}
				},
				{
					"name": "Set As Primary (Cover)",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"url": {
							"raw": "{{base_url_images}}/api/listings/{{listing_id}}/images/{{image_id}}/primary",
							"host": ["{{base_url_images}}"],
							"path": ["api", "listings", "{{listing_id}}", "images", "{{image_id}}", "primary"]
						}
					}
				},
				{
					"name": "Reorder Images",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"imageIds\": [\"{{image_id}}\"]\n}"
						},
						"url": {
							"raw": "{{base_url_images}}/api/listings/{{listing_id}}/images/reorder",
							"host": ["{{base_url_images}}"],
							"path": ["api", "listings", "{{listing_id}}", "images", "reorder"]
						}
					}
				},
				{
					"name": "Delete Image",
					"request": {
						"method": "DELETE",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"url": {
							"raw": "{{base_url_images}}/api/listings/{{listing_id}}/images/{{image_id}}",
							"host": ["{{base_url_images}}"],
							"path": ["api", "listings", "{{listing_id}}", "images", "{{image_id}}"]
						}
					}
				},
				{
					"name": "Upload Avatar",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{"key": "avatar", "type": "file", "src": []}
							]
						},
						"url": {
							"raw": "{{base_url_images}}/api/users/me/avatar",
							"host": ["{{base_url_images}}"],
							"path": ["api", "users", "me", "avatar"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url_auth", "value": "http://localhost:8081", "type": "string" },
		{ "key": "base_url_profile", "value": "http://localhost:8091", "type": "string" },
		{ "key": "base_url_listings", "value": "http://localhost:8083", "type": "string" },
		{ "key": "base_url_images", "value": "http://localhost:8091", "type": "string" },
		{ "key": "auth_token", "value": "", "type": "string" },
		{ "key": "listing_id", "value": "", "type": "string" },
		{ "key": "image_id", "value": "", "type": "string" }
	]
}
